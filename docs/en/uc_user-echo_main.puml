@startuml uc_user-echo_main
!$BGCOLOR = "#C7B6B6FF"
!$FONTCOLOR = "#000000"
!$SUCCESSCOLOR = "#50FA7B"
!$NORMALCOLOR = "#FFFFFF"
!$NOTECOLOR = "#FFFACD"
!$NOTEFONTCOLOR = "#000000"
!$PRIMARYCOLOR = "#3B82F6"
!$SECONDARYCOLOR = "#10B981"
!$WARNINGCOLOR = "#F59E0B"
!$DANGERCOLOR = "#EF4444"
!$LIGHTGRAY = "#F3F4F6"
!$AUTHCOLOR = "#8B5CF6"

skinparam backgroundColor $BGCOLOR
skinparam defaultFontColor $FONTCOLOR
skinparam noteBorderColor $FONTCOLOR
skinparam noteBackgroundColor $NOTECOLOR
skinparam noteFontColor $NOTEFONTCOLOR
skinparam actorBorderColor $FONTCOLOR
skinparam actorBackgroundColor $BGCOLOR
skinparam roundcorner 10

left to right direction

actor "User" as U

rectangle "user-echo" as SYS {
    usecase "uc1\nLaunch TUI and echo module" as UC1
    usecase "uc2\nSubmit message and lock interaction" as UC2
    usecase "uc3\nExecute slash command" as UC3
    usecase "uc4\nDisplay echo content" as UC4
    usecase "uc5\nExpand echo content" as UC5
    usecase "uc6\nCollapse echo content" as UC6
    usecase "uc7\nUpdate session_prompt" as UC7
    usecase "uc8\nUnlock interaction state" as UC8
}

U --> UC1
U --> UC2
U --> UC3
U --> UC5
U --> UC6

UC1 ..> UC4 : <<include>>
UC1 ..> UC7 : <<include>>
UC2 ..> UC8 : <<include>>
UC2 ..> UC7 : <<include>>
UC3 ..> UC4 : <<include>>
UC5 ..> UC4 : <<extend>>
UC6 ..> UC4 : <<extend>>

@enduml
